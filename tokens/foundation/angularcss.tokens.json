  "color": {
    "$description": "Semantic colors consumed by AngularCSS components.",
    "background": {
      "$type": "color",
      "$value": "{palette.slate.1}",
      "$description": "Application background."
    },
    "foreground": {
      "$type": "color",
      "$value": "{palette.slate.12}",
      "$description": "Default text and icon color."
    },
    "card": {
      "$type": "color",
      "$value": "{palette.slate.1}",
      "$description": "Card surface."
    },
    "card-foreground": {
      "$type": "color",
      "$value": "{palette.slate.12}",
      "$description": "Text and icons on card surfaces."
    },
    "popover": {
      "$type": "color",
      "$value": "{palette.slate.1}",
      "$description": "Popover and menu surface."
    },
    "popover-foreground": {
      "$type": "color",
      "$value": "{palette.slate.12}",
      "$description": "Text and icons on popover surfaces."
    },
    "primary": {
      "$type": "color",
      "$value": "{palette.slate.12}",
      "$description": "Primary action and emphasis."
    },
    "primary-foreground": {
      "$type": "color",
      "$value": "{palette.slate.1}",
      "$description": "Content shown on primary actions."
    },
    "secondary": {
      "$type": "color",
      "$value": "{palette.slate.3}",
      "$description": "Secondary action surface."
    },
    "secondary-foreground": {
      "$type": "color",
      "$value": "{palette.slate.12}",
      "$description": "Content shown on secondary actions."
    },
    "muted": {
      "$type": "color",
      "$value": "{palette.slate.3}",
